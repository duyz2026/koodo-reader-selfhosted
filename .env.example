# koodo-sync-hub 配置示例（复制为 .env 后修改，.env 绝不入库）
# 由 install.sh 自动生成；此处仅为参考与手动部署使用。

# Koodo Reader 镜像引用。v1.0.0 已冻结为不可变 digest（与 koodo-image.lock 一致），
# 保证「装一次、版本永久一致」。如需追新版本，改此处或执行 koodo-hub release 后用 upgrade。
KOODO_IMAGE_TAG=ghcr.io/koodo-reader/koodo-reader@sha256:6db5e92fe24dd200674aefe33b0c3d20409eebfe33c14a2b0418aedc7fc01c7d

# 数据源（Docker 模式）管理员账号密码
SERVER_USERNAME=admin
SERVER_PASSWORD=change-me-to-strong

# 访问地址：公网 IP 或域名（install.sh 用于生成 Caddyfile）
SYNC_HOST=your.host.or.ip
SYNC_EMAIL=

# 数据持久化目录（挂载到 koodo 容器 /app/uploads）
DATA_PATH=/srv/koodo/uploads

# Caddy 对外端口（80/443 被占用时可改；模式 1 仍强制 80/443）
HTTP_PORT=80
HTTPS_PORT=443

# 数据源专用端口。客户端（桌面/网页/安卓/iOS）统一用 http(s)://HOST:DS_PORT
# 不使用 /datasource 子路径，因为安卓端不接受路径前缀，只认官方的 host:port 格式。
DS_PORT=8091

# TLS 模式（1/2/3），install.sh 自动写入
TLS_MODE=3

# docker compose 使用的 override 文件，install.sh 自动写入
COMPOSE_FILES="-f docker-compose.yml -f docker-compose.http.yml"

# 冻结开关：1=冻结态（upgrade 禁用），0/缺省=可升级态
FREEZE=0
